# Infinite-Canvas 环境变量说明
# 用法：复制为 .env 或写入 systemd EnvironmentFile，按需设置，不设则用默认值。
# 注意：API Key 优先在网页「API 设置」中配置（存入 API/.env 与 data/api_providers.json），
#       以下变量主要用于覆盖默认行为。

# ===== 服务 =====
# 监听地址与端口（默认 0.0.0.0:3000）
#HOST=0.0.0.0
#PORT=3000

# 访问令牌：设置后所有 /api 与 /ws 需要验证，浏览器首次访问会进入解锁页
# 留空 = 不启用鉴权（仅建议纯内网使用）
#API_TOKEN=

# 跨域白名单：逗号分隔的来源列表，或 "*" 放开所有跨源。
# 默认为空 = 仅同源访问（推荐）。反代到其他域名下访问时才需要配置。
#ALLOWED_ORIGINS=http://192.168.1.10:3000

# ===== ComfyUI =====
# 局域网 ComfyUI 实例，逗号分隔（负载均衡）
#COMFYUI_INSTANCES=127.0.0.1:8188
#COMFYUI_HISTORY_TIMEOUT=1800
#COMFYUI_DOWNLOAD_TIMEOUT=120

# ===== 渠道 =====
# ModelScope（免费 LLM/生图）
#MODELSCOPE_API_KEY=
#MODELSCOPE_CHAT_MODELS=Qwen/Qwen3-235B-A22B

# Comfly 遗留兼容渠道默认值
#COMFLY_BASE_URL=https://ai.comfly.chat
#COMFLY_API_KEY=

# 默认模型
#CHAT_MODEL=gpt-4o-mini
#IMAGE_MODEL=gpt-image-2

# ===== 公网回传地址（生成结果回显给客户端用，可选）=====
# 服务部署在反代/内网之后时，设置对外可见的基础地址
#PUBLIC_BASE_URL=
#PUBLIC_MEDIA_BASE_URL=
#PUBLIC_MEDIA_TOKEN=

# ===== 超时/轮询（一般无需修改）=====
#REQUEST_TIMEOUT=1800
#IMAGE_TASK_TIMEOUT=1800
#IMAGE_POLL_INTERVAL=2
#VIDEO_POLL_TIMEOUT=
#APIMART_IMAGE_TASK_TIMEOUT=1800
#APIMART_IMAGE_INITIAL_POLL_DELAY=
#APIMART_IMAGE_POLL_INTERVAL=
#TUDOU_ASYNC_IMAGE_TASK_TIMEOUT=
#TUDOU_ASYNC_IMAGE_INITIAL_POLL_DELAY=
#TUDOU_ASYNC_IMAGE_POLL_INTERVAL=
#JIMENG_POLL_SECONDS=
#JIMENG_VIDEO_SUBMIT_POLL=
#CODEX_CLI_TIMEOUT=
#GEMINI_CLI_TIMEOUT=
#GEMINI_CLI_IMAGE_TIMEOUT=

# ===== 上传/输入限制 =====
#LLM_MESSAGE_MAX_LENGTH=20000
#MAX_HISTORY_MESSAGES=30
#LOCAL_IMAGE_IMPORT_MAX_BYTES=52428800
#ONLINE_IMAGE_PROMPT_MAX_LENGTH=
#ONLINE_IMAGE_REFERENCE_MAX=
#VIDEO_PROMPT_MAX_LENGTH=
#CHAT_ATTACHMENT_MAX=

# ===== 免费图床兜底（可选）=====
#LITTERBOX_UPLOAD_URL=
#LITTERBOX_TIME=72h
#TEMP_SH_UPLOAD_URL=
#TEMP_SH_MAX_BYTES=
#CLOUD_VIDEO_UPLOAD_SERVICE=
#APIMART_TRY_VIDEO_UPLOAD=

# ===== 以下仅在 Windows 本机开发时生效，Linux 部署请忽略 =====
#LOCALAPPDATA=
#USERPROFILE=
